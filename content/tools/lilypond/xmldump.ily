%% xmldump.ily -- dump LilyPond's interpretation of a score as JSON lines.
%%
%% Part of the digitus2 content pipeline (content/tools/ly2musicxml.py).
%% LilyPond itself parses and interprets the Mutopia source (relative
%% octaves, repeats, variables, voices, tuplets, grace notes, ...); these
%% engravers only *observe* the result and write one JSON object per line
%% to the file named by the environment variable XMLDUMP_OUT.
%% ly2musicxml.py turns the dump into MusicXML.
%%
%% Record types: score, ctx, measure, note, rest, mmrest, tie, slur, beam
%% (via note fields), tuplet, art, fing, dyn, hairpin, text, pedal,
%% arpeggio, trillspan, tempo, key, clef, timesig, barline, volta,
%% repstart, repend, ottava.
%%
%% License: MIT (same as digitus2).

\version "2.24.0"

#(use-modules (srfi srfi-1) (srfi srfi-13))

#(define xd-port #f)
#(define xd-score 0)
#(define xd-id-counter 0)
#(define xd-ctx-counter 0)
#(define xd-ctx-table (make-hash-table))
#(define xd-beam-table (make-hash-table))
#(define xd-beam-counter 0)

#(define (xd-get-port)
   (if (not xd-port)
       (let ((path (or (getenv "XMLDUMP_OUT") "xmldump.jsonl")))
         (set! xd-port (open-file path "w"))
         (set-port-encoding! xd-port "UTF-8")))
   xd-port)

#(define (xd-hex4 n)
   (let ((s (number->string n 16)))
     (string-append (make-string (max 0 (- 4 (string-length s))) #\0) s)))

#(define (xd-json-string s)
   (let ((out (open-output-string)))
     (set-port-encoding! out "UTF-8")
     (write-char #\" out)
     (string-for-each
      (lambda (c)
        (cond ((char=? c #\") (display "\\\"" out))
              ((char=? c #\\) (display "\\\\" out))
              ((char<? c #\space) (display (string-append "\\u" (xd-hex4 (char->integer c))) out))
              (else (write-char c out))))
      s)
     (write-char #\" out)
     (get-output-string out)))

#(define (xd->string v)
   (cond ((string? v) v)
         ((symbol? v) (symbol->string v))
         ((not v) #f)
         ((null? v) #f)
         (else (format #f "~a" v))))

#(define (xd-markup-string m)
   (cond ((not m) #f)
         ((null? m) #f)
         ((string? m) m)
         ((markup? m) (catch #t (lambda () (markup->string m)) (lambda args "?")))
         (else (xd->string m))))

#(define (xd-json v)
   (cond ((eq? v #t) "true")
         ((eq? v #f) "null")
         ((null? v) "[]")
         ((string? v) (xd-json-string v))
         ((symbol? v) (xd-json-string (symbol->string v)))
         ((and (number? v) (exact? v) (integer? v)) (number->string v))
         ((and (number? v) (exact? v)) (xd-json-string (number->string v)))
         ((number? v) (number->string v))
         ((ly:moment? v) (xd-json-string (number->string (ly:moment-main v))))
         ((list? v) (string-append "[" (string-join (map xd-json v) ",") "]"))
         ((pair? v) (string-append "[" (xd-json (car v)) "," (xd-json (cdr v)) "]"))
         (else (xd-json-string (format #f "~a" v)))))

#(define (xd-emit alist)
   (let ((port (xd-get-port)))
     (display "{" port)
     (display (string-join
               (map (lambda (kv)
                      (string-append (xd-json-string (symbol->string (car kv))) ":" (xd-json (cdr kv))))
                    alist)
               ",")
              port)
     (display "}\n" port)
     (force-output port)))

#(define (xd-next-id)
   (set! xd-id-counter (1+ xd-id-counter))
   xd-id-counter)

#(define (xd-ctx-serial ctx)
   (if (not ctx)
       #f
       (or (hashq-ref xd-ctx-table ctx)
           (begin
             (set! xd-ctx-counter (1+ xd-ctx-counter))
             (let ((serial xd-ctx-counter))
               (hashq-set! xd-ctx-table ctx serial)
               (let ((parent (xd-ctx-serial (ly:context-parent ctx))))
                 (xd-emit `((t . "ctx") (score . ,xd-score) (serial . ,serial)
                            (type . ,(symbol->string (ly:context-name ctx)))
                            (id . ,(ly:context-id ctx))
                            (parent . ,parent))))
               serial)))))

#(define (xd-beam-id beam)
   (or (hashq-ref xd-beam-table beam)
       (begin
         (set! xd-beam-counter (1+ xd-beam-counter))
         (hashq-set! xd-beam-table beam xd-beam-counter)
         xd-beam-counter)))

#(define (xd-time-fields context)
   (let ((m (ly:context-current-moment context))
         (mp (ly:context-property context 'measurePosition)))
     `((score . ,xd-score)
       (m . ,(ly:moment-main m))
       (g . ,(ly:moment-grace m))
       (bar . ,(ly:context-property context 'currentBarNumber))
       (mpos . ,(if (ly:moment? mp) (ly:moment-main mp) #f)))))

#(define (xd-col-when g)
   (let ((c (and (ly:grob? g) (if (ly:item? g) (ly:item-get-column g) #f))))
     (if (and (ly:grob? c) (ly:moment? (ly:grob-property c 'when)))
         (ly:grob-property c 'when)
         #f)))

#(define (xd-bound-fields sp)
   (let ((l (xd-col-when (ly:spanner-bound sp LEFT)))
         (r (xd-col-when (ly:spanner-bound sp RIGHT))))
     `((m1 . ,(and l (ly:moment-main l))) (g1 . ,(and l (ly:moment-grace l)))
       (m2 . ,(and r (ly:moment-main r))) (g2 . ,(and r (ly:moment-grace r))))))

#(define (xd-staff-serial context)
   (let ((s (ly:context-find context 'Staff)))
     (if s (xd-ctx-serial s) #f)))

%% ------------------------------------------------------------------
%% Voice-level engraver (also consisted into Dynamics contexts)
%% ------------------------------------------------------------------
#(define (xd-voice-engraver context)
   (let ((heads '())
         (rests '())
         (ties '())
         (repties '())
         (fingrobs '())
         (slurs '())
         (tuplets '())
         (tupnums '())
         (ids (make-hash-table)))
     (define (base)
       (append `((voice . ,(xd-ctx-serial context))
                 (staff . ,(xd-staff-serial context)))
               (xd-time-fields context)))
     (define (bound-ids b)
       (cond ((not (ly:grob? b)) '())
             ((grob::has-interface b 'note-column-interface)
              (let ((hs (ly:grob-object b 'note-heads))
                    (r (ly:grob-object b 'rest)))
                (append
                 (if (ly:grob-array? hs)
                     (filter-map (lambda (h) (hashq-ref ids h)) (ly:grob-array->list hs))
                     '())
                 (if (ly:grob? r)
                     (let ((x (hashq-ref ids r))) (if x (list x) '()))
                     '()))))
             ((hashq-ref ids b) => list)
             (else '())))
     (define (dur-fields d)
       `((log . ,(ly:duration-log d))
         (dots . ,(ly:duration-dot-count d))
         (scale . ,(ly:duration-scale d))))
     (make-engraver
      (listeners
       ((fingering-event engraver ev)
        (xd-emit (append `((t . "fing")
                           (digit . ,(ly:event-property ev 'digit #f))
                           (text . ,(xd-markup-string (ly:event-property ev 'text #f)))
                           (dir . ,(ly:event-property ev 'direction 0)))
                         (base))))
       ((absolute-dynamic-event engraver ev)
        (xd-emit (append `((t . "dyn")
                           (text . ,(xd-markup-string (ly:event-property ev 'text #f)))
                           (dir . ,(ly:event-property ev 'direction 0)))
                         (base))))
       ((span-dynamic-event engraver ev)
        (let ((cls (ly:event-property ev 'class '())))
          (xd-emit (append `((t . "hairpin")
                             (kind . ,(cond ((memq 'crescendo-event cls) "cresc")
                                            ((memq 'decrescendo-event cls) "decresc")
                                            (else "other")))
                             (spandir . ,(ly:event-property ev 'span-direction 0))
                             (spantype . ,(xd->string (ly:event-property ev 'span-type #f)))
                             (spantext . ,(xd-markup-string (ly:event-property ev 'span-text #f))))
                           (base)))))
       ((text-script-event engraver ev)
        (xd-emit (append `((t . "text")
                           (text . ,(xd-markup-string (ly:event-property ev 'text #f)))
                           (dir . ,(ly:event-property ev 'direction 0)))
                         (base))))
       ((sustain-event engraver ev)
        (xd-emit (append `((t . "pedal") (spandir . ,(ly:event-property ev 'span-direction 0))) (base))))
       ((arpeggio-event engraver ev)
        (xd-emit (append '((t . "arpeggio")) (base))))
       ((trill-span-event engraver ev)
        (xd-emit (append `((t . "trillspan") (spandir . ,(ly:event-property ev 'span-direction 0))) (base))))
       ((multi-measure-rest-event engraver ev)
        (let ((d (ly:event-property ev 'duration #f)))
          (xd-emit (append `((t . "mmrest")
                             (len . ,(if (ly:duration? d) (ly:moment-main (ly:duration-length d)) #f)))
                           (base))))))
      (acknowledgers
       ((note-head-interface engraver grob source)
        (if (eq? (ly:translator-context source) context)
            (let ((id (xd-next-id)))
              (hashq-set! ids grob id)
              (set! heads (cons (list id grob (base)) heads)))))
       ((rest-interface engraver grob source)
        (if (and (eq? (grob::name grob) 'Rest) (eq? (ly:translator-context source) context))
            (let ((id (xd-next-id)))
              (hashq-set! ids grob id)
              (set! rests (cons (list id grob (base)) rests)))))
       ((tie-interface engraver grob source)
        (if (eq? (grob::name grob) 'Tie) (set! ties (cons grob ties))))
       ((semi-tie-interface engraver grob source)
        (if (eq? (grob::name grob) 'RepeatTie) (set! repties (cons grob repties))))
       ((finger-interface engraver grob source)
        (if (eq? (grob::name grob) 'Fingering)
            (set! fingrobs (cons (cons grob (base)) fingrobs))))
       ((slur-interface engraver grob source)
        (set! slurs (cons grob slurs)))
       ((tuplet-bracket-interface engraver grob source)
        (set! tuplets (cons grob tuplets)))
       ((tuplet-number-interface engraver grob source)
        (set! tupnums (cons grob tupnums)))
       ((script-interface engraver grob source)
        (if (eq? (grob::name grob) 'Script)
            (let ((ev (event-cause grob)))
              (if ev
                  (xd-emit (append `((t . "art")
                                     (type . ,(xd->string (ly:event-property ev 'articulation-type #f)))
                                     (dir . ,(ly:event-property ev 'direction 0)))
                                   (base))))))))
      ((finalize engraver)
       (for-each
        (lambda (rec)
          (let* ((id (car rec)) (grob (cadr rec)) (fields (caddr rec))
                 (ev (event-cause grob))
                 (p (ly:event-property ev 'pitch #f))
                 (d (ly:event-property ev 'duration #f))
                 (stem (ly:grob-object grob 'stem))
                 (beam (and (ly:grob? stem) (ly:grob-object stem 'beam)))
                 (acc (ly:grob-object grob 'accidental-grob))
                 (arts (ly:event-property ev 'articulations '()))
                 (fingers (filter-map
                           (lambda (a)
                             (and (ly:stream-event? a)
                                  (memq 'fingering-event (ly:event-property a 'class '()))
                                  (or (ly:event-property a 'digit #f)
                                      (xd-markup-string (ly:event-property a 'text #f)))))
                           arts))
                 ;; text scripts inside chords (LilyPond itself drops them with a warning)
                 (texts (filter-map
                         (lambda (a)
                           (and (ly:stream-event? a)
                                (memq 'text-script-event (ly:event-property a 'class '()))
                                (xd-markup-string (ly:event-property a 'text #f))))
                         arts)))
            (xd-emit
             (append
              `((t . "note") (id . ,id))
              fields
              `((step . ,(ly:pitch-notename p))
                (alt . ,(ly:pitch-alteration p))
                (oct . ,(ly:pitch-octave p)))
              (dur-fields d)
              `((fingers . ,fingers)
                (texts . ,texts)
                (acc . ,(if (ly:grob? acc)
                            (list #t
                                  (symbol->string (grob::name acc))
                                  (eq? #t (ly:grob-property-data acc 'parenthesized)))
                            #f))
                (beam . ,(if (ly:grob? beam) (xd-beam-id beam) #f))
                (beaming . ,(if (ly:grob? stem)
                                (let ((b (ly:grob-property-data stem 'beaming)))
                                  (if (pair? b)
                                      (list (if (list? (car b)) (car b) '())
                                            (if (list? (cdr b)) (cdr b) '()))
                                      #f))
                                #f))
                (stemdir . ,(if (ly:grob? stem)
                                (let ((x (ly:grob-property-data stem 'direction)))
                                  (if (number? x) x #f))
                                #f))
                (slash . ,(if (ly:grob? stem)
                              (let ((f (ly:grob-object stem 'flag)))
                                (and (ly:grob? f)
                                     (equal? (ly:grob-property-data f 'stroke-style) "grace")))
                              #f))
                (hidden . ,(eq? #t (ly:grob-property-data grob 'transparent))))))))
        (reverse heads))
       (for-each
        (lambda (rec)
          (let* ((id (car rec)) (grob (cadr rec)) (fields (caddr rec))
                 (ev (event-cause grob))
                 (p (ly:event-property ev 'pitch #f))
                 (d (ly:event-property ev 'duration #f)))
            (xd-emit
             (append
              `((t . "rest") (id . ,id))
              fields
              (dur-fields d)
              `((pitch . ,(if (ly:pitch? p)
                              (list (ly:pitch-notename p) (ly:pitch-alteration p) (ly:pitch-octave p))
                              #f))
                (hidden . ,(eq? #t (ly:grob-property-data grob 'transparent))))))))
        (reverse rests))
       (for-each
        (lambda (t)
          (let ((l (bound-ids (ly:spanner-bound t LEFT)))
                (r (bound-ids (ly:spanner-bound t RIGHT))))
            (xd-emit (append
                      `((t . "tie") (score . ,xd-score) (from . ,l) (to . ,r)
                        (voice . ,(xd-ctx-serial context))
                        (lname . ,(let ((b (ly:spanner-bound t LEFT))) (if (ly:grob? b) (symbol->string (grob::name b)) #f)))
                        (rname . ,(let ((b (ly:spanner-bound t RIGHT))) (if (ly:grob? b) (symbol->string (grob::name b)) #f))))
                      (xd-bound-fields t)))))
        ties)
       (for-each
        (lambda (rt)
          (let ((h (ly:grob-object rt 'note-head)))
            (xd-emit `((t . "repeattie") (score . ,xd-score)
                       (head . ,(if (ly:grob? h) (hashq-ref ids h #f) #f))))))
        repties)
       ;; where LilyPond places each fingering (above/below): for fingerings written after a
       ;; chord this tells which notes they belong to
       (for-each
        (lambda (rec)
          (let* ((g (car rec))
                 (ev (event-cause g))
                 (d (catch #t (lambda () (ly:grob-property g 'direction)) (lambda args 0))))
            (xd-emit (append `((t . "fingdir")
                               (digit . ,(and ev (ly:event-property ev 'digit #f)))
                               (text . ,(and ev (xd-markup-string (ly:event-property ev 'text #f))))
                               (dir . ,(if (number? d) d 0)))
                             (cdr rec)))))
        (reverse fingrobs))
       (for-each
        (lambda (s)
          (xd-emit (append
                    `((t . "slur") (score . ,xd-score)
                      (voice . ,(xd-ctx-serial context))
                      (kind . ,(symbol->string (grob::name s)))
                      (from . ,(bound-ids (ly:spanner-bound s LEFT)))
                      (to . ,(bound-ids (ly:spanner-bound s RIGHT)))
                      (dir . ,(let ((x (ly:grob-property-data s 'direction))) (if (number? x) x 0))))
                    (xd-bound-fields s))))
        slurs)
       (for-each
        (lambda (tb)
          (let* ((cols (let ((a (ly:grob-object tb 'note-columns)))
                         (if (ly:grob-array? a) (ly:grob-array->list a) '())))
                 (nums (filter (lambda (n) (eq? (ly:grob-object n 'bracket) tb)) tupnums))
                 (ev (event-cause tb)))
            (xd-emit (append
                      `((t . "tuplet") (score . ,xd-score)
                        (voice . ,(xd-ctx-serial context))
                        (first . ,(if (pair? cols) (bound-ids (car cols)) '()))
                        (last . ,(if (pair? cols) (bound-ids (last cols)) '()))
                        (ncols . ,(length cols))
                        (num . ,(and ev (ly:event-property ev 'numerator #f)))
                        (den . ,(and ev (ly:event-property ev 'denominator #f)))
                        (bracketvis . ,(xd->string (ly:grob-property-data tb 'bracket-visibility)))
                        (bracketstencil . ,(not (eq? #f (ly:grob-property-data tb 'stencil))))
                        (numbervisible . ,(and (pair? nums)
                                               (not (eq? #f (ly:grob-property-data (car nums) 'stencil)))
                                               (not (eq? #t (ly:grob-property-data (car nums) 'transparent))))))
                      (xd-bound-fields tb)))))
        tuplets)))))

%% ------------------------------------------------------------------
%% Staff-level engraver: clefs, keys, time signatures, bar lines, ottava
%% ------------------------------------------------------------------
#(define (xd-staff-engraver context)
   (let ((last-clef #f) (ottavas '()))
     (define (sf) (append `((staff . ,(xd-ctx-serial context))) (xd-time-fields context)))
     (make-engraver
      (listeners
       ((key-change-event engraver ev)
        (xd-emit (append
                  `((t . "key")
                    (tonic . ,(let ((p (ly:event-property ev 'tonic #f)))
                                (if (ly:pitch? p) (list (ly:pitch-notename p) (ly:pitch-alteration p)) #f)))
                    (alist . ,(map (lambda (e) (list (if (pair? (car e)) (cdar e) (car e)) (cdr e)))
                                   (ly:event-property ev 'pitch-alist '()))))
                  (sf)))))
      (acknowledgers
       ((bar-line-interface engraver grob source)
        (let ((gl (ly:grob-property-data grob 'glyph)))
          (if (and (string? gl) (not (string=? gl "|")))
              (xd-emit (append `((t . "barline") (glyph . ,gl)) (sf))))))
       ((time-signature-interface engraver grob source)
        (let ((fr (ly:grob-property-data grob 'fraction)))
          (xd-emit (append `((t . "timesig")
                             (frac . ,(if (pair? fr) (list (car fr) (cdr fr)) #f))
                             (style . ,(xd->string (ly:grob-property-data grob 'style))))
                           (sf)))))
       ((ottava-bracket-interface engraver grob source)
        (set! ottavas (cons (cons grob (ly:context-property context 'ottavation)) ottavas))))
      ((stop-translation-timestep engraver)
       (let ((clef (list (ly:context-property context 'clefGlyph)
                         (ly:context-property context 'clefPosition)
                         (ly:context-property context 'clefTransposition))))
         (if (not (equal? clef last-clef))
             (begin
               (set! last-clef clef)
               (xd-emit (append `((t . "clef")
                                  (glyph . ,(xd->string (car clef)))
                                  (pos . ,(if (number? (cadr clef)) (cadr clef) #f))
                                  (transp . ,(if (number? (caddr clef)) (caddr clef) 0)))
                                (sf)))))))
      ((finalize engraver)
       (for-each
        (lambda (o)
          (xd-emit (append `((t . "ottava") (score . ,xd-score)
                             (staff . ,(xd-ctx-serial context))
                             (octaves . ,(if (number? (cdr o)) (cdr o) #f)))
                           (xd-bound-fields (car o)))))
        ottavas)))))

%% ------------------------------------------------------------------
%% Score-level engraver: measures, tempo, repeats, volta brackets
%% ------------------------------------------------------------------
#(define (xd-score-engraver context)
   (let ((voltas '()) (first #t))
     (make-engraver
      ((initialize engraver)
       (set! xd-score (1+ xd-score))
       (xd-emit `((t . "score") (score . ,xd-score))))
      (listeners
       ((tempo-change-event engraver ev)
        (xd-emit (append
                  `((t . "tempo")
                    (text . ,(xd-markup-string (ly:event-property ev 'text #f)))
                    (unit . ,(let ((u (ly:event-property ev 'tempo-unit #f)))
                               (if (ly:duration? u) (list (ly:duration-log u) (ly:duration-dot-count u)) #f)))
                    (count . ,(let ((c (ly:event-property ev 'metronome-count #f)))
                                (cond ((number? c) c)
                                      ((pair? c) (list (car c) (cdr c)))
                                      (else #f)))))
                  (xd-time-fields context))))
       ((volta-repeat-start-event engraver ev)
        (xd-emit (append '((t . "repstart")) (xd-time-fields context))))
       ((volta-repeat-end-event engraver ev)
        (xd-emit (append `((t . "repend") (count . ,(ly:event-property ev 'repeat-count #f)))
                         (xd-time-fields context)))))
      (acknowledgers
       ((volta-bracket-interface engraver grob source)
        (set! voltas (cons grob voltas)))
       ((metronome-mark-interface engraver grob source)
        (xd-emit (append `((t . "tempomark")
                           (transparent . ,(eq? #t (ly:grob-property-data grob 'transparent)))
                           (nostencil . ,(eq? #f (ly:grob-property-data grob 'stencil)))
                           (hidenote . ,(eq? #t (ly:context-property context 'tempoHideNote))))
                         (xd-time-fields context)))))
      ((stop-translation-timestep engraver)
       (let ((mp (ly:context-property context 'measurePosition))
             (ts (ly:context-property context 'timeSignatureFraction))
             (ml (ly:context-property context 'measureLength)))
         (if (or first (and (ly:moment? mp) (zero? (ly:moment-main mp))))
             (xd-emit (append `((t . "measure")
                                (len . ,(if (ly:moment? ml) (ly:moment-main ml) #f))
                                (ts . ,(if (pair? ts) (list (car ts) (cdr ts)) #f)))
                              (xd-time-fields context))))
         (set! first #f)))
      ((finalize engraver)
       (for-each
        (lambda (v)
          (xd-emit (append `((t . "volta") (score . ,xd-score)
                             (text . ,(xd-markup-string (ly:grob-property-data v 'text))))
                           (xd-bound-fields v))))
        voltas)
       (xd-emit `((t . "endscore") (score . ,xd-score)))))))

\layout {
  \context { \Voice \consists #xd-voice-engraver }
  \context { \Dynamics \consists #xd-voice-engraver }
  \context { \Staff \consists #xd-staff-engraver }
  \context { \Score \consists #xd-score-engraver }
}
