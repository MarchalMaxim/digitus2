{
  "name": "digitus2-render-spike",
  "private": true,
  "version": "0.0.0",
  "description": "THROWAWAY technical spike: score rendering, playback and parsing candidates for digitus2. Not app code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4317 --strictPort",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "fetch:samples": "node scripts/fetch-samples.mjs",
    "sizes": "node scripts/bundle-sizes.mjs",
    "measure": "node scripts/measure.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sizes:css": "node scripts/css-size.mjs",
    "check:node": "tsx scripts/proof-check.ts && tsx scripts/snippet-check.ts && tsx scripts/midi-check.ts && tsx scripts/parse-bench-node.ts"
  },
  "dependencies": {
    "@audio/musicxml": "0.1.0",
    "@rgrove/parse-xml": "5.0.0",
    "@stringsync/musicxml": "0.3.0",
    "@stringsync/vexml": "1.12.1",
    "@tonejs/midi": "2.0.28",
    "@tonejs/piano": "0.2.1",
    "@xmldom/xmldom": "0.9.12",
    "events": "3.3.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "jszip": "3.10.2",
    "midi-file": "1.2.4",
    "midi-json-parser": "8.1.75",
    "motion": "14.2.0",
    "musicxml-interfaces": "0.0.21",
    "musicxml-io": "0.12.1",
    "opensheetmusicdisplay": "2.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "smplr": "1.1.0",
    "soundfont-player": "0.12.0",
    "spessasynth_lib": "4.3.14",
    "tone": "15.1.22",
    "tone14": "npm:tone@14.7.77",
    "txml": "6.0.3",
    "verovio": "6.3.0",
    "vexflow": "5.0.0",
    "webmidi": "2.5.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.59.1",
    "tailwindcss": "4.3.3",
    "tsx": "4",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
